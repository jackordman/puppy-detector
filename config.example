# Copy to config.local (gitignored). sync.sh ships it to the Pi as /opt/puppy-detector/config.env.
RTSP_URL="rtsps://USER:PASS@CAMERA_IP:322/stream0"
OUT_DIR=/srv/nas/share/puppycam
MODEL=yolov8n.pt
IMGSZ=416
CONF=0.4
# COCO class ids treated as the dog (16 dog, 15 cat, 21 bear, 77 teddy bear)
CLASSES=16
MAX_GB=20
# phase 2/3, harmless until squat.pt exists / topic set
CLASSIFIER=/opt/puppy-detector/squat.pt
SQUAT_CONF=0.6
CONSECUTIVE=3
EVENT_COOLDOWN=120
NTFY_TOPIC=

# ring buffer
MAX_REC_GB=250
